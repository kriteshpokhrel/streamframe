# StreamFrame publishing — copy to .env and fill in.
#
# .env is git-ignored on purpose: it holds the client secrets that can post to
# your accounts. Share it through your password manager, never through git.
# OAuth tokens are NOT stored here; `streamframe publish auth` writes them to
# the state directory with mode 0600.

# --- what gets published --------------------------------------------------
# Comma-separated subset of: youtube,instagram,tiktok
STREAMFRAME_PUBLISH_PLATFORMS=youtube,instagram,tiktok

# Publish every finished export automatically. This is the app-level default;
# each job can override it with --auto-publish / --no-auto-publish.
STREAMFRAME_PUBLISH_AUTO=0

# Where the ledger and OAuth tokens live. Defaults to <data dir>/publish.
# Where the ledger and OAuth tokens live. Pin this if the server and the CLI
# use different data directories: `./streamframe` serves with ./.streamframe,
# while `streamframe publish auth` defaults to ~/.streamframe.
STREAMFRAME_PUBLISH_STATE_DIR=~/.streamframe/publish

# --- YouTube --------------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Desktop)
# Enable "YouTube Data API v3" and add your Google account as a test user.
STREAMFRAME_YOUTUBE_CLIENT_ID=
STREAMFRAME_YOUTUBE_CLIENT_SECRET=
# public | unlisted | private
STREAMFRAME_YOUTUBE_PRIVACY=public
STREAMFRAME_YOUTUBE_CATEGORY_ID=24
STREAMFRAME_YOUTUBE_MADE_FOR_KIDS=false

# --- Instagram ------------------------------------------------------------
# Meta app dashboard -> Instagram -> API setup with Instagram login.
# The account must be a Business or Creator account.
STREAMFRAME_INSTAGRAM_APP_ID=
STREAMFRAME_INSTAGRAM_APP_SECRET=
STREAMFRAME_INSTAGRAM_API_VERSION=v23.0
STREAMFRAME_INSTAGRAM_SHARE_TO_FEED=true
# instagram = graph.instagram.com. Older "Instagram login" apps only.
# facebook  = graph.facebook.com. Instagram account linked to a Facebook Page.
#             New Meta apps are only offered this variant or Unified login.
STREAMFRAME_INSTAGRAM_LOGIN=facebook

# --- TikTok ---------------------------------------------------------------
# developers.tiktok.com -> app -> Login Kit + Content Posting API.
# Scope needed is video.upload only; no audit is required for inbox drafts.
STREAMFRAME_TIKTOK_CLIENT_KEY=
STREAMFRAME_TIKTOK_CLIENT_SECRET=

# --- public media host (Instagram only) -----------------------------------
# YouTube and TikTok take the file bytes, so only Instagram needs a public URL.
#
# none   : Instagram is skipped with a clear message
# catbox : free, no account or card; the file expires on its own (default)
# local  : copy into a directory you already serve over HTTPS
# r2     : Cloudflare R2 or any S3-compatible bucket (R2 asks for a card)
STREAMFRAME_MEDIA_HOST=catbox

# catbox only: 1h, 12h, 24h or 72h. Meta fetches within seconds, so 1h is plenty.
STREAMFRAME_CATBOX_EXPIRY=1h

# Required for both local and r2: the public prefix clips are served from.
# STREAMFRAME_MEDIA_PUBLIC_BASE_URL=https://clips.example.com

# local only:
# STREAMFRAME_MEDIA_LOCAL_DIR=/srv/clips/public

# r2 only (Cloudflare dashboard -> R2 -> Manage API tokens):
# STREAMFRAME_R2_BUCKET=streamframe-clips
# STREAMFRAME_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STREAMFRAME_R2_ACCESS_KEY_ID=
# STREAMFRAME_R2_SECRET_ACCESS_KEY=

# --- timeouts -------------------------------------------------------------
# Per-request timeout and how long to wait for Instagram to finish processing.
STREAMFRAME_PUBLISH_HTTP_TIMEOUT=120
STREAMFRAME_PUBLISH_POLL_TIMEOUT=300
